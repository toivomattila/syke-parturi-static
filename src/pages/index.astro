---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import { Image } from 'astro:assets';
import interior from '../assets/barbershop.png';
import { business } from '../data/business';
const title = `${business.name} — Parturi Lahdessa`;
const description = `${business.name} Lahdessa. ${business.services.map((service) => `${service.name} ${service.price} €`).join(' ja ')}. ${business.address.street}, ${business.address.postalCode} ${business.address.locality}.`;
const offerCatalog = {
  '@type': 'OfferCatalog',
  name: 'Palvelut',
  itemListElement: business.services.map((service) => ({
    '@type': 'Offer',
    price: String(service.price),
    priceCurrency: service.currency,
    itemOffered: { '@type': 'Service', name: service.name },
  })),
};
const structuredData = {
  '@context': 'https://schema.org', '@type': 'HairSalon', name: business.name,
  address: {
    '@type': 'PostalAddress',
    streetAddress: business.address.street,
    postalCode: business.address.postalCode,
    addressLocality: business.address.locality,
    addressCountry: business.address.country,
  },
  telephone: business.phone.international,
  url: business.url,
  image: 'https://sykeparturi.datato.fi/og-image.png',
  priceRange: `${Math.min(...business.services.map((service) => service.price))} €–${Math.max(...business.services.map((service) => service.price))} €`,
  taxID: business.businessId,
  hasOfferCatalog: offerCatalog,
};
---
<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <header class="site-header">
    <div class="container header-inner">
      <a class="brand" href="#alku"><span class="brand-mark" aria-hidden="true">S</span><span>SYKE <span class="brand-light">PARTURI</span></span></a>
      <nav aria-label="Päänavigaatio"><a href="#palvelut">Palvelut</a><a href="#yhteystiedot">Yhteystiedot</a><Button href={business.phone.href} variant="outline" class="header-call">Soita meille <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.2 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.96.36 1.9.7 2.8a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.84.58 2.8.7a2 2 0 0 1 1.73 2.03z"/></svg></Button></nav>
    </div>
  </header>
  <main id="main">
    <section class="hero" id="alku" aria-labelledby="hero-title">
      <div class="hero-image" aria-hidden="true"><Image src={interior} alt="Syke Parturin viihtyisä ja huolella järjestetty parturiliike" width={1500} height={1000} widths={[600, 900, 1200, 1500]} sizes="100vw" format="webp" quality={72} loading="eager" fetchpriority="high" /></div>
      <div class="hero-shade" aria-hidden="true"></div>
      <div class="container hero-content">
        <p class="eyebrow">Parturi · Lahti</p>
        <h1 id="hero-title">Hyvä tyyli.<br /><span>Hyvä syke.</span></h1>
        <p class="hero-copy">Hiustenleikkaukset ja parran muotoilu Lahden keskustassa.</p>
        <div class="hero-actions"><Button href={business.phone.href}>Soita: {business.phone.display} <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.2 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.96.36 1.9.7 2.8a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.84.58 2.8.7a2 2 0 0 1 1.73 2.03z"/></svg></Button><a class="text-link" href="#palvelut">Tutustu palveluihin <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 5v14m-7-7 7 7 7-7"/></svg></a></div>
      </div>
    </section>
    <section class="section services" id="palvelut" aria-labelledby="services-title">
      <div class="container">
        <div class="section-heading"><div><p class="eyebrow">Selkeät hinnat</p><h2 id="services-title">Palvelut <span>& hinnat</span></h2></div><p>Valitse palvelu ja soita, niin sovitaan käynnistä.</p></div>
        <div class="service-grid">
          {business.services.map((service) => (
            <Card class="service-card"><h3>{service.name}</h3><p class="service-price">{service.price} <span>€</span></p></Card>
          ))}
        </div>
      </div>
    </section>
    <section class="contact" id="yhteystiedot" aria-labelledby="contact-title">
      <div class="container contact-grid">
        <div class="contact-intro"><p class="eyebrow">Tervetuloa</p><h2 id="contact-title">Ota yhteyttä.<br /><span>Tule käymään.</span></h2><p>{business.openingHours}</p></div>
        <div class="contact-details">
          <div class="detail"><span class="detail-label">Osoite</span><address>{business.address.street}<br />{business.address.postalCode} {business.address.locality}</address><a class="detail-link" href={business.directionsUrl} target="_blank" rel="noreferrer">Avaa reittiohjeet <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M15 3h6v6m-11 5L21 3M19 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h6"/></svg></a></div>
          <div class="detail"><span class="detail-label">Puhelin</span><a class="phone-link" href={business.phone.href}>{business.phone.display}</a><a class="detail-link" href={business.phone.href}>Soita meille <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.2 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.96.36 1.9.7 2.8a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.84.58 2.8.7a2 2 0 0 1 1.73 2.03z"/></svg></a></div>
          <div class="detail business-id"><span class="detail-label">Y-tunnus</span><p>{business.businessId}</p></div>
        </div>
      </div>
    </section>
  </main>
  <footer class="site-footer"><div class="container footer-inner"><a class="brand" href="#alku"><span class="brand-mark" aria-hidden="true">S</span><span>SYKE <span class="brand-light">PARTURI</span></span></a><span>© {business.name} · {business.address.locality}</span><a class="back-top" href="#alku">Takaisin ylös ↑</a></div></footer>
  <script>
    import '../scripts/webmcp';
  </script>
</BaseLayout>
<style>
  .site-header { position: absolute; z-index: 2; top: 0; left: 0; width: 100%; border-bottom: 1px solid rgb(255 255 255 / 10%); }
  .header-inner,.site-header nav,.brand,.footer-inner { display: flex; align-items: center; }
  .header-inner { min-height: 82px; justify-content: space-between; }
  .brand { gap: .75rem; font-family: var(--font-display); font-size: .88rem; font-weight: 800; letter-spacing: .12em; text-decoration: none; }
  .brand-mark { display: grid; width: 2rem; height: 2rem; place-items: center; border: 1px solid var(--gold); color: var(--gold); font-family: var(--font-display); font-size: 1rem; }
  .brand-light { color: var(--muted); font-weight: 400; }
  .site-header nav { gap: 2.25rem; font-size: .88rem; }
  .site-header nav>a:not(.button) { text-decoration: none; color: #e4e1da; }
  .site-header nav>a:hover { color: var(--gold); }
  .header-call { min-height: 2.7rem; padding: .55rem .85rem; }
  .button svg,.detail-link svg,.text-link svg { width: 1em; height: 1em; flex: none; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .hero { position: relative; display: flex; min-height: 720px; min-height: min(850px, 100svh); align-items: center; overflow: hidden; background: var(--green); }
  .hero-image,.hero-shade { position: absolute; inset: 0; }
  .hero-image img { width: 100%; height: 100%; object-fit: cover; object-position: center 45%; }
  .hero-shade { background: linear-gradient(90deg, rgb(8 21 17 / 94%) 0%, rgb(8 21 17 / 78%) 38%, rgb(8 21 17 / 20%) 100%), linear-gradient(0deg, rgb(8 21 17 / 48%), transparent 35%); }
  .hero-content { position: relative; z-index: 1; padding-top: 5rem; }
  h1,h2,h3,p { margin-top: 0; }
  h1,h2 { font-family: var(--font-display); font-weight: 600; letter-spacing: -.055em; }
  h1 { max-width: 750px; margin-bottom: 1.25rem; font-size: clamp(4rem, 9vw, 7.75rem); line-height: .98; }
  h1 span,h2 span { color: var(--gold); }
  .hero-copy { max-width: 430px; margin-bottom: 2rem; color: #d1d0c8; font-size: 1.1rem; }
  .hero-actions { display: flex; align-items: center; gap: 1.6rem; }
  .text-link { color: var(--ink); font-size: .92rem; text-decoration-color: var(--gold); text-underline-offset: 5px; }
  .services { background: #10231d; }
  .section-heading { display: flex; justify-content: space-between; align-items: end; gap: 2rem; margin-bottom: 2rem; }
  h2 { margin-bottom: 0; font-size: clamp(2.35rem, 5.3vw, 4.5rem); line-height: 1.04; }
  .section-heading>p { max-width: 280px; margin-bottom: .45rem; color: #d0ccc3; font-size: 1rem; }
  .service-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
  .service-card { display: flex; min-height: 0; align-items: center; justify-content: space-between; gap: 1rem; padding: 1.25rem 1.5rem; transition: border-color .2s ease, background .2s ease; }
  .service-card:hover { border-color: rgb(213 172 112 / 60%); background: rgb(255 255 255 / 4%); }
  .service-card h3 { margin: 0; font-family: var(--font-display); font-size: clamp(1.15rem, 2.2vw, 1.5rem); font-weight: 550; letter-spacing: -.03em; }
  .service-card p { color: var(--muted); font-size: .9rem; }
  .service-price { flex: none; margin: 0; font-family: var(--font-display); font-size: 1.4rem; font-weight: 650; }
  .service-price span { color: #795c22; }
  .contact { padding-block: 5.5rem; background: #d9d4c8; color: #14241e; }
  .contact .eyebrow { color: #68461f; }
  .contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; }
  .contact-intro h2 { margin-bottom: 1.25rem; font-size: clamp(2.2rem, 4.8vw, 4.2rem); }
  .contact-intro h2 span { color: #795c22; }
  .contact-intro>p:last-child { color: #49574f; }
  .contact-details { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem 1rem; align-content: center; }
  .detail { display: flex; flex-direction: column; align-items: start; }
  .detail-label { margin-bottom: .65rem; color: #35473d; font-size: .82rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  address,.business-id p,.phone-link { margin: 0; font-size: 1.1rem; font-style: normal; line-height: 1.6; }
  .phone-link { font-size: 1.45rem; font-weight: 650; text-decoration: none; }
  .detail-link { display: inline-flex; align-items: center; gap: .25rem; margin-top: .5rem; color: #294b39; font-size: .95rem; text-underline-offset: 4px; }
  .business-id { grid-column: 1 / -1; padding-top: .8rem; border-top: 1px solid rgb(20 36 30 / 18%); }
  .site-footer { background: #08130f; }
  .footer-inner { min-height: 100px; justify-content: space-between; gap: 1rem; color: #c9c5bc; font-size: .9rem; }
  .footer-inner .brand { color: var(--ink); }
  .back-top { text-decoration: none; }
  @media (max-width: 700px) { .header-inner { min-height: 70px; } .site-header nav { gap: 1rem; } .site-header nav>a:not(.button) { display: none; } .header-call { min-height: 2.5rem; font-size: .9rem; } .hero { min-height: 650px; min-height: 82svh; } .hero-shade { background: linear-gradient(90deg, rgb(8 21 17 / 90%), rgb(8 21 17 / 45%)), linear-gradient(0deg, rgb(8 21 17 / 60%), transparent 65%); } .hero-content { padding-top: 4rem; } .section-heading { display: block; } .section-heading>p { margin-top: 1rem; } .service-grid { grid-template-columns: minmax(0, 1fr); } .contact-grid { grid-template-columns: 1fr; gap: 2rem; } .contact { padding-block: 3.5rem; } .contact-details { align-content: start; } .footer-inner { flex-wrap: wrap; padding-block: 1.25rem; } .footer-inner>span { order: 1; width: 100%; } }
  @media (max-width: 400px) { .hero-actions { align-items: flex-start; flex-direction: column; gap: 1.1rem; } .contact-details { grid-template-columns: 1fr; } .business-id { grid-column: auto; } .service-card { min-width: 0; } .service-card h3 { min-width: 0; } .phone-link { font-size: 1.2rem; } }
  @media (max-width: 360px) { .header-inner { width: calc(100% - 2rem); min-height: 0; align-items: flex-start; flex-direction: column; gap: .6rem; padding-block: .65rem; } .site-header nav { width: 100%; justify-content: flex-end; } .hero { align-items: flex-start; } .hero-content { padding-top: 9rem; } h1 { font-size: clamp(3.1rem, 15vw, 4rem); } .hero-copy { font-size: 1rem; } .service-card { padding: 1rem; } }
</style>
