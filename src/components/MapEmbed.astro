---
interface Props {
  embedUrl: string;
  title: string;
}

const { embedUrl, title } = Astro.props;
---

<div class="map-embed">
  <iframe
    src={embedUrl}
    title={title}
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    allowfullscreen
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
  ></iframe>
</div>

<style>
  .map-embed {
    width: 100%;
    margin-top: 2.5rem;
    border: 1px solid rgb(20 36 30 / 22%);
    background: #c8c2b6;
    overflow: hidden;
  }
  .map-embed iframe {
    display: block;
    width: 100%;
    height: min(420px, 55vw);
    min-height: 280px;
    border: 0;
  }
  @media (max-width: 700px) {
    .map-embed {
      margin-top: 2rem;
    }
    .map-embed iframe {
      min-height: 240px;
    }
  }
</style>
