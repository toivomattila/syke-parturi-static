---
interface Props {
  embedUrl: string;
  title: string;
}

const { embedUrl, title } = Astro.props;
---

<div class="map-embed">
  <iframe
    src={embedUrl}
    title={title}
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    allowfullscreen
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
  ></iframe>
</div>

<style>
  .map-embed {
    position: relative;
    width: 100%;
    margin-top: 2.5rem;
    aspect-ratio: 16 / 10;
    border: 1px solid rgb(20 36 30 / 22%);
    background: #c8c2b6;
    overflow: hidden;
  }
  .map-embed iframe {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
  @media (max-width: 700px) {
    .map-embed {
      margin-top: 2rem;
      aspect-ratio: auto;
      height: clamp(300px, 88vw, 360px);
    }
  }
</style>
